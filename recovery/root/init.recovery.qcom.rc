import /init.recovery.wifi.rc

on early-init
    wait /sys/fs/selinux/enforce
    write /sys/fs/selinux/enforce 0

# Qualcomm EGL imports gralloc-native buffers. Keep the stock allocator in an
# init-managed process so AERA's Adreno renderer can import the KMS buffers.
service aera-graphics-allocator /vendor/bin/hw/vendor.qti.hardware.display.allocator-service
    class hal
    seclabel u:r:recovery:s0
    user root
    group root graphics
    capabilities SYS_NICE
    # Do not spin every five seconds if a vendor/runtime mismatch prevents
    # registration. A healthy allocator stays resident after its first start.
    oneshot

on early-fs
    write /proc/sys/walt/sched_lib_name "recovery,magiskboot,Updater,updater,update_engine_sideload"
    write /proc/sys/walt/sched_lib_mask_force 255

on fs
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    # Firmware must exist before the initial WLAN module pass
    # pd-mapper helper recognises this read-only, current-slot mount and can reuse it
    # Do not bind /vendor/firmware_mnt here; AERA temporarily mounts /vendor
    # during module discovery and a nested mount could obstruct its unmount
    mkdir /firmware 0755 root root
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1
    chmod 0660 /dev/qseecom
    chown system drmrpc /dev/qseecom
    chmod 0664 /dev/ion
    chown system system /dev/ion
    mkdir /mnt/vendor 0775 shell system
    mkdir /mnt/vendor/persist 0775 shell system
    mkdir /tmp/persist 0775 shell system
    mount none /tmp/persist /mnt/vendor/persist bind rec

on init
    start vendor.boot-qti

on boot
    setprop sys.usb.config adb
    # Dual LED flashlight workaround
    start peridot-flashlight

service peridot-flashlight /system/bin/peridot_flashlight.sh
    class core
    user root
    group root
    seclabel u:r:recovery:s0

service aera-audio-bootstrap /system/bin/aera_audio_bootstrap.sh
    class core
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0
    stdio_to_kmsg

service aera-pdmapper-boot /system/bin/sh /system/bin/aera_pdmapper_bootstrap.sh
    class core
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0
    stdio_to_kmsg

service aera-pd-mapper /system/bin/aera-pd-mapper
    class core
    disabled
    user system
    group system
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /system/lib64/aera-pdmapper:/system/lib64
    stdio_to_kmsg

service aera-dspservice /vendor/bin/aera-dspservice
    class hal
    disabled
    user system
    group system wakelock 2908
    capabilities BLOCK_SUSPEND
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /vendor/aera-audio-abi:/vendor/aera-stock-lib64:/vendor/lib64:/system/lib64
    interface vendor.qti.hardware.dsp@1.0::IDspService dspservice
    stdio_to_kmsg

service aera-audioadsprpcd /vendor/bin/aera-audioadsprpcd audiopd
    class main
    disabled
    user media
    group media
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /vendor/aera-audio-abi:/vendor/aera-stock-lib64:/vendor/lib64:/system/lib64
    stdio_to_kmsg

# Slot-matched stock Qualcomm audio HAL. Started only after the real machine card
# exists so that AGMIPC/PAL can register without touching pre-decrypt vendor state.
service aera-stock-audio-hal /vendor/bin/hw/android.hardware.audio.service
    class hal
    disabled
    oneshot
    user root
    group root audio system media
    capabilities BLOCK_SUSPEND SYS_NICE
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /vendor/aera-audio-abi:/vendor/aera-stock-lib64:/mnt/aera-stock/odm/lib64:/vendor/lib64:/system/lib64
    setenv ANDROID_ROOT /system
    setenv ANDROID_DATA /data
    interface android.hardware.audio@7.1::IDevicesFactory default
    interface android.hardware.audio.effect@7.0::IEffectsFactory default
    interface vendor.qti.hardware.AGMIPC@1.0::IAGM default
    interface vendor.qti.hardware.pal@1.0::IPAL default
    stdio_to_kmsg

service aera-audio-primary-opener /system/bin/aera-audio-primary-opener
    class hal
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0
    stdio_to_kmsg

on property:twrp.modules.loaded=true
    wait /sys/class/power_supply/battery 2
    start vendor.qseecomd
    start vendor.health-recovery
    start vibratorfeature-hal-service
    start aera-pdmapper-boot

# Keep the audio lock until battery / soundcard setup is finished
on property:vendor.aera.pdmapper.ready=1 && property:init.svc.aera-pd-mapper=running && property:init.svc.aera-pdmapper-boot=running
    setprop vendor.aera.pdmapper.ready 0
    # Load ADSP firmware for PMIC with pd-mapper already running
    write /dev/kmsg "[aera-pdmapper-boot] init requesting ADSP boot"
    write /sys/kernel/boot_adsp/boot 1

on property:post.decrypt.modules=true
    write /dev/kmsg "[aera-audio] post-decrypt bootstrap requested"
    start aera-audio-bootstrap

on property:vendor.sys.listeners.registered=true
    start vendor.ssgtzd
    start vendor.secure_element
    start vendor.weaver_nxp
    start vendor.keymint-qti
    start vendor.gatekeeper_default
