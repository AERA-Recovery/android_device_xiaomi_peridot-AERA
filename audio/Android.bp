cc_binary {
    name: "aera-audio-bridge",
    recovery: true,
    srcs: ["aera_audio_bridge.cpp"],
    shared_libs: ["libdl"],
    cpp_std: "c++17",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

cc_binary {
    name: "aera-audio-primary-opener",
    recovery: true,
    srcs: ["aera_audio_primary_opener.cpp"],
    shared_libs: [
        "android.hardware.audio@7.0",
        "android.hardware.audio@7.1",
        "libhidlbase",
        "libutils",
    ],
    cpp_std: "c++17",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}
